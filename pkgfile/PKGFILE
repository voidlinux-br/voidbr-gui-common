pkgname=voidbr-gui-common
pkgdesc="VoidBR GUI Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=()  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=() # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	Adapta                  # Tema GTK (arquivos)
	adwaita-icon-theme      # Tema de ícones GNOME/GTK (arquivos)
	adwaita-plus            # Extensão do tema Adwaita (arquivos)
	font-awesome            # Fontes de ícones
	font-iosevka            # Fonte monoespaçada
	gdk-pixbuf              # Carregamento de imagens (GTK)
	libavif                 # Suporte a imagens AVIF
	libheif                 # Suporte a imagens HEIF
	libheif-pixbuf-loader   # Integração libheif/gdk-pixbuf
	nerd-fonts-symbols-ttf  # Símbolos Nerd Font
	noto-fonts-emoji        # Fontes de emoji da Google
	noto-fonts-ttf          # Fontes Noto (arquivos)
	terminus-font           # Fonte de console
	ttf-jetbrains-mono-nerd # Fonte JetBrains Mono Nerd
	ttf-ubuntu-font-family  # Fonte Ubuntu
	voidbr-beauty-icons     # Tema de ícones VoidBR (arquivos)
	voidbr-tokyo-theme      # Tema Tokyo Night (arquivos)
	voidbr-wallpapers       # Wallpapers VoidBR (arquivos)
	voidbr-webapps          # Atalhos de webapps VoidBR (arquivos .desktop)
  chili-iso2usb           # utilitario para gravar iso em pendrive/device
  lightdm
  lightdm-gtk-greeter
  lightdm-gtk-greeter-settings
  arc-theme
  papirus-icon-theme
  dejavu-fonts-ttf
  voidbr-lightdm-themes
  sddm
  voidbr-sddm-themes
)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
